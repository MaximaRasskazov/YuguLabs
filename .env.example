# Единый конфиг проекта. Используется и docker compose, и локальным
# backend/Makefile (через include ../.env).
#
# Быстрый старт:
#   make setup     # создаст .env из этого файла, сгенерит JWT_SECRET,
#                  # поднимет docker compose и накатит миграции
#
# Файл .env находится в .gitignore — реальные секреты не коммитятся.

# Application
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info

# PostgreSQL.
# DB_HOST / DB_PORT — для команд, запускаемых С ХОСТА (make migrate-up,
# make test-integration, локальный go run). Внутри docker-сети backend
# обращается к сервису по имени "postgres" на 5432 — этот хост
# захардкожен в docker-compose.yml.
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=academic_debts
DB_USER=academic
DB_PASSWORD=academic

# JWT и сессии. JWT_SECRET — обязателен, минимум 32 байта.
# Сгенерировать вручную: openssl rand -hex 32
# `make setup` делает это автоматически.
JWT_SECRET=replace-me-with-openssl-rand-hex-32-output-please-do-not-use-this
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Cookie для refresh-токена. На проде с HTTPS COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_PATH=/
COOKIE_SAMESITE=lax

# CORS. Origin'ы фронта через запятую.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost,http://localhost:8080

# SMTP — опционально. По умолчанию используется mailpit (письма видны
# на localhost:8025 в dev и на <host>:8025 в прод).
# Чтобы отправлять реальные письма — задай SMTP_HOST и credentials.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@academic.local

# Dev-сиды: при true entrypoint.sh после миграций накатит
# 00011_seed_dev_accounts.sql c демо-аккаунтами (см. README).
# В prod держать false.
SEED_DEV_ACCOUNTS=true

# Git-webhook авто-деплоя (лаба №6). Пустой GIT_WEBHOOK_SECRET держит
# эндпоинт POST /api/hooks/git выключенным (503). Ключ — строка 36 символов,
# хранится ТОЛЬКО здесь, в репозиторий не попадает. Сгенерировать:
#   openssl rand -hex 18   (даёт 36 hex-символов)
GIT_WEBHOOK_SECRET=
# Ветка деплоя: git checkout <branch> && git pull origin <branch>.
GIT_DEFAULT_BRANCH=main
# Каталог git-репозитория, где выполняются команды (должен содержать .git).
GIT_REPO_PATH=.
# Файл журнала деплоя (JSON Lines). Каталог создаётся автоматически.
GIT_DEPLOY_LOG=storage/logs/deployment.log
# Потолок времени на весь деплой.
GIT_DEPLOY_TIMEOUT=5m
